{
  "buildCommand": "npm run build",
  "devCommand": "PORT=3000 npm start",
  "installCommand": "npm install",
  "framework": "react",
  "outputDirectory": "build",
  "env": {
    "CI": "true",
    "PORT": "3000"
  },
  "envPrefix": "REACT_APP_",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "regions": ["iad1"],
  "public": false,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  }
}
